[
  {
    "id": "success_incremental_update",
    "user_query": "帮我记一下我今天投了这个岗位，另外上个月投的那个还没消息，帮我记下该跟进了",
    "available_context": {
      "status_update_events": [
        {
          "event": "投递了岗位A",
          "date": "3月10日",
          "source": "公司官网"
        },
        {
          "event": "上个月投的岗位B还没消息，该跟进了",
          "date": "2月5日",
          "source": "招聘平台"
        }
      ],
      "current_tracking_records": {},
      "verified_opportunity_list": [
        {
          "opportunity_id": "opp_a",
          "name": "岗位A"
        },
        {
          "opportunity_id": "opp_b",
          "name": "岗位B"
        }
      ],
      "user_followup_cadence": {
        "interval": "7天",
        "preferred_channel": "邮件"
      }
    },
    "expected_outcome": "success",
    "must_include": [
      "application_tracking_ledger.opportunities.opp_a.latest_status 为 applied",
      "application_tracking_ledger.opportunities.opp_b.latest_status 为 needs_followup",
      "opportunities.opp_b.next_action 包含按用户偏好渠道跟进",
      "status_source 保留 公司官网 和 招聘平台 原文"
    ],
    "must_not_include": [
      "修改 verified_opportunity_list 的内容",
      "为 opp_a 或 opp_b 补造不存在的面试记录",
      "调用普通工具获取系统当前时间"
    ]
  },
  {
